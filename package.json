{
  "name": "web-3d-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Lightweight browser-based 3D modeling, animation and collaborative studio",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pages": "playwright test",
    "preview:pages": "node scripts/serve-pages.mjs",
    "supabase:setup": "node scripts/generate-supabase-setup.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.185.4",
    "jsdom": "^26.1.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=22"
  }
}
