# This is a Vite app: NEXT_PUBLIC_* names from Next.js are NOT read by Vite.
# Copy to .env.local for local development. Leave both empty for local mode.
# Production / GitHub Pages defaults are in .env.production (public values only).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy alternative to a publishable key. Use ONLY the anon JWT,
# never a service-role JWT or sb_secret_* key. Prefer the publishable key above.
VITE_SUPABASE_ANON_KEY=

# GitHub OAuth App client id (optional).
VITE_GITHUB_CLIENT_ID=

VITE_APP_NAME=Web 3D Studio

# --- AI defaults (all optional; the app ships with free no-key providers) ---
# Custom OpenAI-compatible assistant (Ask tab + ai.ask). Empty = free Pollinations.
VITE_AI_ASSISTANT_URL=
VITE_AI_ASSISTANT_KEY=
VITE_AI_ASSISTANT_MODEL=
# Custom OpenAI-compatible image endpoint (textures). Empty = free Pollinations.
VITE_AI_IMAGE_URL=
VITE_AI_IMAGE_KEY=
VITE_AI_IMAGE_MODEL=
# Custom text-to-3D endpoint (full URL, returns GLB). Empty = free Spaces below.
VITE_AI_3D_URL=
VITE_AI_3D_KEY=
VITE_AI_3D_MODEL=
# Free 3D Space overrides (Stable Fast 3D = default, TripoSR = fallback).
VITE_AI_SF3D_SPACE=
VITE_AI_TRIPOSR_SPACE=
# Optional Hugging Face token (shorter queues on both Spaces, free).
VITE_HF_TOKEN=
# Optional Pollinations key (free at enter.pollinations.ai/keys) — routes Ask
# through the current keyed API with higher reliability/limits.
VITE_POLLINATIONS_KEY=
# Local agent-relay server URL (see `npm run agent-relay`). Empty = relay off.
VITE_AGENT_RELAY_URL=
