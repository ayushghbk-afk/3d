# This is a Vite app: NEXT_PUBLIC_* names from Next.js are NOT read by Vite.
# Copy to .env.local for local development. Leave both empty for local mode.
# Production / GitHub Pages defaults are in .env.production (public values only).
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional legacy alternative to a publishable key. Use ONLY the anon JWT,
# never a service-role JWT or sb_secret_* key. Prefer the publishable key above.
VITE_SUPABASE_ANON_KEY=

# GitHub OAuth App client id (optional).
VITE_GITHUB_CLIENT_ID=

VITE_APP_NAME=Web 3D Studio
