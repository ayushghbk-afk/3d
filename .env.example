# Supabase (cloud sync, auth, realtime). Leave empty for local/offline mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# GitHub OAuth App client id (optional, enables Device Flow login without a PAT).
# Create at https://github.com/settings/developers — no backend required.
VITE_GITHUB_CLIENT_ID=

# App
VITE_APP_NAME=Web 3D Studio
